#!/usr/bin/expect -f

set force_conservative 0  ;# set to 1 to force conservative mode even if
			  ;# script wasn't run conservatively originally
if {$force_conservative} {
	set send_slow {1 .1}
	proc send {ignore arg} {
		sleep .1
		exp_send -s -- $arg
	}
}

#set prompt "(% |# |>|> |\\$ ) $";
#catch {set prompt $env(EXPECT_PROMPT)}
set PASS [lindex $argv 0]
set SERVER [lindex $argv 1]

set timeout -1
spawn $env(SHELL)
match_max 100000
expect "> "
send -- "ssh -p 2222 $env(USER)@punifiops030"
expect -exact "-p 2222 $env(USER)@punifiops030"
send -- "\r"
expect -exact "\r
\r
  Opsware Global Shell\r
\r
$env(USER)@opsware's password:"
send -- "$PASS\r"
expect "~>"
send -- "rosh -l root -n $SERVER\r"
expect {
	"# " { send -- "bash\r" }
	">" { send -- "bash\r" }
	"> " { send -- "bash\r" }
	"% " { send -- "bash\r" }
	"$ " { send -- "bash\r" }
	"~ " { send -- "bash\r" }
	}
expect {
   "# " { send -- ". /export/home/$env(USER)/.bashrc\r" }
   ">" { send -- ". /export/home/$env(USER)/.bashrc\r" }
   #">" { send -- ". `grep $env(USER) /etc/passwd | awk -F: '{print \$6}'`/.bashrc\r" }
   ">" { send -- ". /export/home/$env(USER)/.bashrc\r" }
   "> " { send -- ". /export/home/$env(USER)/.bashrc\r" }
   "% " { send -- ". /export/home/$env(USER)/.bashrc\r" }
   "$ " { send -- ". /export/home/$env(USER)/.bashrc\r" }
   "~ " { send -- ". /export/home/$env(USER)/.bashrc\r" }
}
expect {
   "# " { send -- ". /home/$env(USER)/.bashrc\r" }
   ">" { send -- ". /home/$env(USER)/.bashrc\r" }
   #">" { send -- ". `grep $env(USER) /etc/passwd | awk -F: '{print \$6}'`/.bashrc\r" }
   ">" { send -- ". /home/$env(USER)/.bashrc\r" }
   "> " { send -- ". /home/$env(USER)/.bashrc\r" }
   "% " { send -- ". /home/$env(USER)/.bashrc\r" }
   "$ " { send -- ". /home/$env(USER)/.bashrc\r" }
   "~ " { send -- ". /home/$env(USER)/.bashrc\r" }
}
#expect -re $prompt
interact

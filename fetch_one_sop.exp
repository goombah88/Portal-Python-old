#!/usr/bin/expect -f

set force_conservative 0  ;# set to 1 to force conservative mode even if
			  ;# script wasn't run conservatively originally
if {$force_conservative} {
	set send_slow {1 .1}
	proc send {ignore arg} {
		sleep .1
		exp_send -s -- $arg
	}
}

set PASS [lindex $argv 0]
set SOP [lindex $argv 1]
set HOSTNAME [lindex $argv 2]
set SOP_LOCATION [lindex $argv 3]

set timeout -1
spawn $env(SHELL)
match_max 100000
expect "> "
send -- "ssh -p 2222 $env(USER)@punifiops030"
expect -exact "-p 2222 $env(USER)@punifiops030"
send -- "\r"
expect -exact "\r
\r
  Opsware Global Shell\r
\r
$env(USER)@opsware's password:"
send -- "$PASS\r"
expect "~>"
send -- "cp -Rp /home/common/ServiceDesk/cwiz/SOP/$SOP /opsw/Server/@/$HOSTNAME/files/root$SOP_LOCATION/\r"
expect "~>"
send -- "chmod -R 777 /opsw/Server/@/$HOSTNAME/files/root$SOP_LOCATION/\r"
expect "~>"
#interact
#expect "~>"
send -- "exit\r"
send -- "exit\r"
send -- "exit\r"

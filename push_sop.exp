#!/usr/bin/expect -f

# Push one SOP from local to GlobalShell

set force_conservative 0  ;# set to 1 to force conservative mode even if
			  ;# script wasn't run conservatively originally
if {$force_conservative} {
	set send_slow {1 .1}
	proc send {ignore arg} {
		sleep .1
		exp_send -s -- $arg
	}
}

set PASS [lindex $argv 0]
set HOSTNAME [lindex $argv 1]
set ACTIVE [lindex $argv 2]
set SOP_LOCATION [lindex $argv 3]
set LST_FILE [lindex $argv 4]

set timeout -1
spawn $env(SHELL)
match_max 100000
expect "> "
send -- "ssh -p 2222 $env(USER)@punifiops030"
expect -exact "-p 2222 $env(USER)@punifiops030"
send -- "\r"
expect -exact "\r
\r
  Opsware Global Shell\r
\r
$env(USER)@opsware's password:"
send -- "$PASS\r"
expect "~>"
send -- "cp -Rp /opsw/Server/@/$HOSTNAME/files/root$SOP_LOCATION/$ACTIVE/$ACTIVE.Desc /home/common/ServiceDesk/cwiz/SOP/$ACTIVE/$ACTIVE.Desc \r"
expect "~>"
send -- "cp -Rp /opsw/Server/@/$HOSTNAME/files/root$SOP_LOCATION/$ACTIVE/$ACTIVE.Impl /home/common/ServiceDesk/cwiz/SOP/$ACTIVE/$ACTIVE.Impl \r"
expect "~>"
send -- "cp -Rp /opsw/Server/@/$HOSTNAME/files/root$SOP_LOCATION/$ACTIVE/$ACTIVE.Back /home/common/ServiceDesk/cwiz/SOP/$ACTIVE/$ACTIVE.Back \r"
expect "~>"
send -- "cp -Rp /opsw/Server/@/$HOSTNAME/files/root$SOP_LOCATION/$ACTIVE/$ACTIVE.Val /home/common/ServiceDesk/cwiz/SOP/$ACTIVE/$ACTIVE.Val \r"
expect "~>"
send -- "cp -Rp /opsw/Server/@/$HOSTNAME/files/root$SOP_LOCATION/$ACTIVE/$ACTIVE.serverlist /home/common/ServiceDesk/cwiz/CwizLists/$LST_FILE \r"
expect "~>"
send -- "exit\r"

1. lvcrate -L 500M -n FS_ESP vgroot && mkfs -t ext3 /dev/vgroot/FS_ESP && mkdir /ESPSystemAgent && echo '/dev/vgroot/FS_ESP    /ESPSystemAgent              ext3    defaults        1 2' >> /etc/fstab && mount /ESPSystemAgent && rm -rf /ESPSystemAgent/* && rpm -qa |grep LibXp
2. Install ESP via Opsware
3. add /bin/bash to the oscomponent.validshell parameter of agentparm.txt
